SECRET_KEY=replace-with-at-least-64-random-characters
PORTAL_HOSTNAME=localhost
DATABASE_URL=postgresql+psycopg://portal:change-me@db:5432/portal
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SESSION_COOKIE_SECURE=true
ENABLE_ENTRA=true
ENABLE_LDAP=true
ENABLE_LOCAL=true
DEFAULT_AUTH_PROVIDER=entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://localhost/auth/entra/callback
ENTRA_AUTO_PROVISION=true
LDAP_URI=ldaps://ad.example.com:636
LDAP_BASE_DN=DC=example,DC=com
LDAP_BIND_DN=CN=svc_portal,OU=Service Accounts,DC=example,DC=com
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_DISPLAYNAME_ATTRIBUTE=displayName
LDAP_TLS_VALIDATE=true
LDAP_AUTO_PROVISION=true
ALLOW_IDENTITY_AUTO_LINK=false
FOREMAN_URL=https://foreman.example.com
FOREMAN_USERNAME=
FOREMAN_PASSWORD=
FOREMAN_API_TOKEN=
FOREMAN_VERIFY_TLS=true
# FOREMAN_CA_BUNDLE=/app/secrets/ca/foreman-ca.pem
FOREMAN_TIMEOUT_SECONDS=30
# Background Foreman status reconciliation interval. Minimum: 2 seconds.
FOREMAN_RECONCILE_INTERVAL_SECONDS=5
# Periodic Foreman host inventory sync interval (seconds); default 900 = 15 minutes.
FOREMAN_HOST_SYNC_INTERVAL_SECONDS=900
FOREMAN_MOCK=true
# Required only when a Chiklet contains x-sensitive fields. Inject VAULT_TOKEN
# through your deployment secret manager; do not commit a real token here.
VAULT_ADDR=
VAULT_TOKEN=
# Prefer a mounted secret file over an environment variable in production.
VAULT_TOKEN_FILE=
VAULT_KV_MOUNT=portal
VAULT_KV_PREFIX=requests
# VAULT_CA_BUNDLE=/app/secrets/ca/vault-ca.pem
VAULT_TIMEOUT_SECONDS=10
BOOTSTRAP_ADMIN_USERNAME=portal-admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
BOOTSTRAP_ADMIN_EMAIL=
