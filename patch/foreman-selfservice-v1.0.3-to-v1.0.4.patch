+        <small>{{ a.decided_at.strftime('%Y-%m-%d %H:%M:%S') }}{% if a.comment %} · {{ a.comment }}{% endif %}</small>
+      </div>
+    </div>
+    {% else %}
+    <p class="muted">Awaiting an authorised approver.</p>
+    {% endfor %}
+  </section>
+
+  <section
+    class="card execution-card"
