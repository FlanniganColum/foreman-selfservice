+          <strong>Foreman output</strong>
+          <span class="muted" id="output-refresh-state">Auto-refreshing while active</span>
+        </div>
+        <div class="output-actions">
+          <span class="muted" id="output-last-refreshed">Not loaded yet</span>
+          <button type="button" class="button subtle small" id="copy-output">Copy</button>
+          <button type="button" class="button subtle small" id="load-output" data-output-url="{{ url_for('api.request_output',request_id=item.id) }}">Refresh now</button>
+        </div>
+      </div>
+      <pre id="job-output" class="job-output" tabindex="0">Waiting for Foreman output…</pre>
+    </div>
+    <div id="output-placeholder" class="output-placeholder muted"{% if item.execution and item.execution.foreman_job_id %} hidden{% endif %}>Foreman output will appear here after the request is approved and submitted.</div>
+
+    {% if item.execution and item.execution.error_message %}
+    <div class="alert danger" id="execution-error">{{ item.execution.error_message }}</div>
+    {% else %}
+    <div class="alert danger" id="execution-error" hidden></div>
+    {% endif %}
+  </section>
+</div>
+{% endblock %}
