+    def get_template_inputs(self, template_id):
+        """Return the user/template inputs exposed by a Foreman job template.
+
+        Foreman exposes job-template inputs through the generic templates API:
+        GET /api/templates/:template_id/template_inputs.
+        """
+        if self.mock:
