+    def validate_input_contract(self, config_snapshot, template_id=None):
+        """Fail closed when the Chiklet/Foreman input contract is inconsistent.
+
+        Every input_map destination must exist in Foreman. Conversely, a Foreman
+        template input that is not mapped must have a non-blank Foreman default,
+        unless it is explicitly listed in foreman.allow_unmapped_inputs. This
+        prevents blank template inputs silently overriding Ansible role defaults.
+        """
+        if self.mock:
+            return {}
+
+        fcfg = config_snapshot["foreman"]
+        template_id = template_id or self.resolve_template_id(fcfg)
+        remote_inputs = self.get_template_inputs(template_id)
+        remote_by_name = {
+            item.get("name"): item
+            for item in remote_inputs
+            if isinstance(item, dict) and item.get("name")
+        }
+        mapped_names = set((fcfg.get("input_map") or {}).keys())
+        allowed_unmapped = set(fcfg.get("allow_unmapped_inputs") or [])
+
+        missing_in_foreman = sorted(mapped_names - set(remote_by_name))
+        if missing_in_foreman:
+            raise ForemanContractError(
+                "Chiklet maps Foreman input(s) that do not exist on template "
+                f"{template_id}: {', '.join(missing_in_foreman)}"
+            )
+
+        unsafe_unmapped = []
+        for name, item in remote_by_name.items():
+            if name in mapped_names or name in allowed_unmapped:
+                continue
+            if item.get("required") is True or _is_blank(item.get("default")):
+                unsafe_unmapped.append(name)
+
+        if unsafe_unmapped:
+            raise ForemanContractError(
+                "Foreman template has unmapped input(s) with no safe default: "
+                f"{', '.join(sorted(unsafe_unmapped))}. Add them to the Chiklet form_schema/input_map, "
+                "set a non-blank Foreman default, or explicitly list intentional exceptions in "
+                "foreman.allow_unmapped_inputs."
+            )
+        return remote_by_name
+
+    def build_inputs(self, config_snapshot, form_data, remote_by_name=None):
+        """Build Foreman inputs from the immutable request plus schema defaults.
+
+        The request snapshot is normally complete, but schema defaults are applied
+        again defensively so an older/incomplete snapshot cannot cause a mapped
+        enum/default value to become an empty Foreman input.
+        """
+        fcfg = config_snapshot["foreman"]
+        properties = (config_snapshot.get("form_schema") or {}).get("properties") or {}
+        inputs = {}
+
+        for foreman_name, source_name in (fcfg.get("input_map") or {}).items():
+            spec = properties.get(source_name) or {}
+            has_value = source_name in form_data
+            value = form_data.get(source_name)
+
+            # Empty/missing values must not discard a meaningful schema default.
+            if (not has_value or _is_blank(value)) and "default" in spec and not _is_blank(spec.get("default")):
+                value = spec["default"]
+                has_value = True
+
+            if has_value:
+                inputs[foreman_name] = value
+                continue
+
+            # If the Chiklet did not provide a value, leave a non-blank Foreman
+            # default alone. Otherwise required remote inputs are a contract error.
+            remote = (remote_by_name or {}).get(foreman_name, {})
+            if not _is_blank(remote.get("default")):
+                continue
+            if remote.get("required") is True:
+                raise ForemanContractError(
+                    f"Mapped Foreman input {foreman_name!r} has no submitted value, schema default, or Foreman default"
+                )
+
+        return inputs
+
+    def preflight_inputs(self, config_snapshot, form_data):
+        """Resolve the template, validate the live input contract and build inputs."""
+        if self.mock:
+            return None, self.build_inputs(config_snapshot, form_data)
+        template_id = self.resolve_template_id(config_snapshot["foreman"])
+        remote_by_name = self.validate_input_contract(config_snapshot, template_id=template_id)
+        return template_id, self.build_inputs(config_snapshot, form_data, remote_by_name=remote_by_name)
