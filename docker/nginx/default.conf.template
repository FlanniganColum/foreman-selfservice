limit_req_zone $binary_remote_addr zone=login:10m rate=20r/m;
upstream portal_web { server web:8000; keepalive 32; }
server { listen 80; server_name ${PORTAL_HOSTNAME}; return 301 https://$host$request_uri; }
server {
  listen 443 ssl; http2 on; server_name ${PORTAL_HOSTNAME};
  ssl_certificate /etc/nginx/certs/fullchain.pem; ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3; ssl_session_cache shared:SSL:10m;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always; add_header X-Frame-Options DENY always;
  client_max_body_size 2m;
  location /auth/ { limit_req zone=login burst=10 nodelay; proxy_pass http://portal_web; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; }
  location / { proxy_pass http://portal_web; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; }
}
