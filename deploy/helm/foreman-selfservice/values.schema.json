{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1}
      }
    },
    "redis": {
      "type": "object",
      "required": ["enabled", "image", "existingSecret", "port", "persistence"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingSecret": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "maxmemory": {"type": "string", "minLength": 1},
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "persistence": {
          "type": "object",
          "required": ["enabled", "size"],
          "properties": {
            "enabled": {"type": "boolean"},
            "size": {"type": "string", "minLength": 1},
            "storageClass": {"type": "string"}
          }
        }
      }
    },
    "chiklets": {
      "type": "object",
      "required": ["mode", "mountPath"],
      "properties": {
        "mode": {"type": "string", "enum": ["bundled", "existingConfigMap", "pvc", "image"]},
        "existingConfigMap": {"type": "string"},
        "existingClaim": {"type": "string"},
        "mountPath": {"type": "string", "minLength": 1}
      }
    },
    "web": {
      "type": "object",
      "required": ["replicaCount"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1}
      }
    },
    "worker": {
      "type": "object",
      "required": ["replicaCount", "concurrency"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "concurrency": {"type": "integer", "minimum": 1}
      }
    },
    "scheduler": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "host"],
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string", "minLength": 1},
        "pathType": {"type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"]}
      }
    }
  }
}
